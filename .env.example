# Ollama (local, free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chroma persistence directory
CHROMA_PERSIST_DIR=./.chroma

# API
API_HOST=127.0.0.1
API_PORT=8000

# Retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MAX_REWRITES=2

# Optional: set to compare against OpenAI models (never required)
# OPENAI_API_KEY=
